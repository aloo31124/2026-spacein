{
  "name": "space-in",
  "version": "2.2.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cy:open": "cypress open --e2e --browser chrome",
    "cy:run": "cypress run --e2e",
    "e2e": "start-server-and-test start http://localhost:4201 cy:run",
    "cap:sync": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "android:sync": "npm run build:prod && npx cap sync android",
    "android:open": "npm run build:prod && npx cap sync android && npx cap open android",
    "android:run": "npm run build:prod && npx cap sync android && npx cap run android",
    "android:build:debug": "npm run build:prod && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:build:release": "npm run build:prod && npx cap sync android && cd android && ./gradlew bundleRelease",
    "android:build:apk": "npm run build:prod && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@capacitor-community/apple-sign-in": "^5.0.0",
    "@capacitor/android": "^5.7.3",
    "@capacitor/app": "^5.0.8",
    "@capacitor/cli": "^5.7.3",
    "@capacitor/core": "^5.7.3",
    "@capacitor/ios": "^5.7.3",
    "@capacitor/preferences": "^5.0.8",
    "@codetrix-studio/capacitor-google-auth": "^3.3.6",
    "@fontsource/noto-sans-tc": "5.3.0",
    "chart.js": "^4.4.2",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "~17.3.17",
    "@angular/compiler-cli": "^17.3.12",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^20.11.0",
    "cypress": "^13.15.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "start-server-and-test": "^2.0.8",
    "typescript": "~5.4.5"
  }
}
